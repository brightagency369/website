function init(){
if(document.getElementById("bac"))return;
var st=document.createElement("style");st.textContent="#bac{--panel:#1d1830;--head:#2a2240;--ink:#f1eefb;--mut:#b4acd0;--bot:rgba(255,255,255,.13);--me:#ffca3a;--meink:#241b12;--line:rgba(255,255,255,.18);--y:#ffca3a;--p:#ff6b8b;--t:#2ec4b6;--field:rgba(255,255,255,.1);--glow:.5;color-scheme:dark light}\n@media (prefers-color-scheme:light){#bac:not([data-theme=\"dark\"]){--panel:#fff9ec;--head:#ffefc7;--ink:#2a2038;--mut:#6b6280;--bot:rgba(255,255,255,.8);--me:#2a2038;--meink:#fff;--line:rgba(42,32,56,.18);--field:#fff;--glow:.35}}\n#bac #bac-fab{position:fixed;right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(96px + env(safe-area-inset-bottom,0px));width:68px;height:68px;border:0;padding:0;border-radius:50%;background:none;cursor:pointer;z-index:2147483000;touch-action:none;user-select:none;-webkit-user-select:none}\n#bac #bac-fab img{width:68px;height:68px;border-radius:50%;display:block;position:relative;box-shadow:0 6px 20px rgba(0,0,0,.35)}\n#bac #bac-fab::before,#bac #bac-fab::after{content:\"\";position:absolute;inset:0;border-radius:50%;border:3px solid var(--p);animation:bac-ring 2.4s ease-out infinite}\n#bac #bac-fab::after{border-color:var(--t);animation-delay:1.2s}\n@keyframes bac-ring{from{transform:scale(1);opacity:.8}to{transform:scale(1.7);opacity:0}}\n#bac #bac-fab.hide{display:none}\n#bac #bac-panel{position:fixed;right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));width:min(380px,calc(100vw - 24px));height:min(640px,calc(100% - 32px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));background:var(--panel);border-radius:22px;box-shadow:0 18px 50px rgba(0,0,0,.45);display:flex;flex-direction:column;overflow:hidden;z-index:2147483001;transform-origin:bottom right;transition:transform .3s cubic-bezier(.2,.9,.3,1.2),opacity .2s}\n#bac #bac-panel.closed{transform:scale(.4);opacity:0;pointer-events:none;visibility:hidden}\n#bac header{display:flex;align-items:center;gap:11px;padding:12px 14px;background:var(--head);border-bottom:3px solid var(--y)}\n#bac .logo{width:48px;height:48px;border-radius:50%;flex:none;display:block}\n#bac header b{display:block;font-size:16px;color:var(--ink)}\n#bac header span{font-size:12.5px;color:var(--mut);display:flex;align-items:center;gap:6px}\n#bac .on{width:8px;height:8px;border-radius:50%;background:var(--t);animation:bac-blink 1.8s infinite}\n@keyframes bac-blink{50%{opacity:.35}}\n#bac #bac-x{margin-left:auto;background:none;border:0;color:var(--ink);font-size:28px;line-height:1;cursor:pointer;padding:4px 8px}\n#bac #bac-stage{position:relative;flex:1;min-height:0}\n#bac .bg{position:absolute;inset:0;overflow:hidden;z-index:0;pointer-events:none}\n#bac .bg i{position:absolute;border-radius:50%;opacity:var(--glow);will-change:transform}\n#bac .bg i:nth-child(1){width:210px;height:210px;background:var(--y);left:-60px;top:6%;animation:bac-d1 14s ease-in-out infinite}\n#bac .bg i:nth-child(2){width:180px;height:180px;background:var(--p);right:-50px;top:38%;animation:bac-d2 17s ease-in-out infinite}\n#bac .bg i:nth-child(3){width:230px;height:230px;background:var(--t);left:18%;bottom:-90px;animation:bac-d3 20s ease-in-out infinite}\n@keyframes bac-d1{50%{transform:translate(120px,160px) scale(1.15)}}\n@keyframes bac-d2{50%{transform:translate(-140px,-120px) scale(.85)}}\n@keyframes bac-d3{50%{transform:translate(110px,-140px) scale(1.2)}}\n#bac #bac-log{position:absolute;inset:0;z-index:1;overflow-y:auto;padding:14px 12px;display:flex;flex-direction:column;gap:10px}\n#bac .m{max-width:86%;padding:10px 13px;border-radius:16px;white-space:pre-wrap;word-wrap:break-word;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}\n#bac .in{animation:bac-pop .28s cubic-bezier(.2,.9,.3,1.3)}\n@keyframes bac-pop{from{opacity:0;transform:translateY(10px) scale(.92)}}\n#bac .b{background:var(--bot);color:var(--ink);align-self:flex-start;border-bottom-left-radius:4px;border:1px solid var(--line)}\n#bac .u{background:var(--me);color:var(--meink);align-self:flex-end;border-bottom-right-radius:4px;font-weight:600}\n#bac .typing{display:flex;gap:5px;padding:14px}\n#bac .typing span{width:8px;height:8px;border-radius:50%;background:var(--ink);opacity:.5;animation:bac-bounce 1s infinite}\n#bac .typing span:nth-child(2){animation-delay:.15s}\n#bac .typing span:nth-child(3){animation-delay:.3s}\n@keyframes bac-bounce{40%{transform:translateY(-6px);opacity:1}}\n#bac .hero{width:130px;border-radius:14px;display:block;margin-bottom:8px}\n#bac .chips{display:flex;flex-wrap:wrap;gap:8px;align-self:flex-start;max-width:96%}\n#bac .chip{border:1.5px solid var(--ink);background:var(--bot);color:var(--ink);padding:9px 13px;border-radius:999px;font:inherit;font-size:14px;cursor:pointer;transition:transform .15s,background .15s}\n#bac .chip:active{transform:scale(.94)}\n#bac .chip[aria-pressed=\"true\"]{background:var(--y);border-color:var(--y);color:#241b12;font-weight:700;transform:scale(1.04)}\n#bac .go{background:var(--y);color:#241b12;border:0;padding:12px 18px;border-radius:12px;font:inherit;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block;align-self:flex-start;box-shadow:0 4px 0 var(--p)}\n#bac .go.alt{background:var(--t);color:#07221f;box-shadow:0 4px 0 var(--y)}\n#bac .go:active{transform:translateY(3px);box-shadow:0 1px 0 var(--p)}\n#bac .chip:focus-visible,#bac .go:focus-visible,#bac input:focus-visible,#bac #bac-x:focus-visible,#bac #bac-fab:focus-visible{outline:3px solid var(--t);outline-offset:2px}\n#bac form{display:flex;gap:8px;padding:10px 12px;background:var(--head);margin:0}\n#bac input{flex:1;min-width:0;font:inherit;padding:11px 13px;border-radius:12px;border:1.5px solid var(--line);background:var(--field);color:var(--ink)}\n#bac input:disabled{opacity:.5}\n#bac form button{background:var(--t);color:#07221f;border:0;border-radius:12px;padding:0 16px;font:inherit;font-weight:700;cursor:pointer}\n@media (prefers-reduced-motion:reduce){#bac *,#bac *::before,#bac *::after{animation:none!important;transition:none!important}}\n#bac{font:16px/1.45 \"Trebuchet MS\",system-ui,sans-serif;color:var(--ink)}";document.head.appendChild(st);
var r=document.createElement("div");r.id="bac";r.innerHTML="<button id=\"bac-fab\" aria-label=\"Open chat\"><img alt=\"\" src=\"data:image/png;base64,\"></button>\n<section id=\"bac-panel\" class=\"closed\" role=\"dialog\" aria-label=\"Bright Ads & Marketing chat\">\n<header><img class=\"logo\" alt=\"Bright Ads & Marketing logo\" src=\"data:image/png;base64,\"><div><b>Bright Ads & Marketing</b><span><i class=\"on\"></i>Online \u00b7 replies fast</span></div><button id=\"bac-x\" aria-label=\"Close chat\">\u00d7</button></header>\n<div id=\"bac-stage\"><div class=\"bg\"><i></i><i></i><i></i></div><div id=\"bac-log\" aria-live=\"polite\"></div></div>\n<form id=\"bac-f\"><input id=\"bac-t\" placeholder=\"Type here\u2026\" autocomplete=\"off\" disabled><button>Send</button></form>\n</section>";document.body.appendChild(r);
